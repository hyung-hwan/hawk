@pragma entry main
@pragma implicit off
@pragma pedantic on

@include "tap.inc";

function read_file(path)
{
	@local f, data, buf;

	data = "";
	f = sys::open(path, sys::O_RDONLY);
	if (f <= -1) return @nil;

	while (sys::read(f, buf, 4096) > 0) data = data %% buf;
	sys::close(f);
	return data;
}

function run_pipe_test(label, prog, expect)
{
	@local out, cmd, data;

	out = sys::tempname("hawk-pipecloexec-" label "-");
	if (out == "")
	{
		tap_fail(sprintf("%s[%d] %s - unable to create a temporary file - %s", @SCRIPTNAME, @SCRIPTLINE, label, sys::errmsg()));
		return;
	}
	cmd = sprintf("%s '%s' 3>\"%s\" 2>/dev/null", ARGV[0], prog, out);
	system(cmd);

	data = read_file(out);
	if (hawk::isnil(data)) data = "";

	if (data === expect)
	{
		tap_ok(sprintf("%s[%d] %s", @SCRIPTNAME, @SCRIPTLINE, label));
	}
	else
	{
		tap_fail(sprintf("%s[%d] %s expected '%s' got '%s'", @SCRIPTNAME, @SCRIPTLINE, label, expect, data));
	}

	sys::unlink(out);
}

function test_tempname()
{
	@local p1, p2, bad, line, rc;

	p1 = sys::tempname();
	tap_ensure(p1 != "", 1, @SCRIPTNAME, @SCRIPTLINE);
	if (p1 == "") return;

	p2 = sys::tempname("hawk-tempname-test-");
	tap_ensure(p2 != "", 1, @SCRIPTNAME, @SCRIPTLINE);
	if (p2 == "")
	{
		sys::unlink(p1);
		return;
	}

	tap_ensure(p1 != p2, 1, @SCRIPTNAME, @SCRIPTLINE);
	tap_ensure(sys::basename(p2) ~ /^hawk-tempname-test-/, 1, @SCRIPTNAME, @SCRIPTLINE);

	rc = (getline line < p1);
	close(p1);
	tap_ensure(rc, 0, @SCRIPTNAME, @SCRIPTLINE);

	print "temporary data" > p1;
	close(p1);
	rc = (getline line < p1);
	close(p1);
	tap_ensure(rc, 1, @SCRIPTNAME, @SCRIPTLINE);
	tap_ensure(line, "temporary data", @SCRIPTNAME, @SCRIPTLINE);

	bad = sys::tempname("invalid/prefix");
	tap_ensure(bad, "", @SCRIPTNAME, @SCRIPTLINE);
	tap_ensure(sys::errmsg() != "", 1, @SCRIPTNAME, @SCRIPTLINE);

	sys::unlink(p1);
	sys::unlink(p2);
}

function main()
{
	## if PIPCLOEXEC is turned on, the file descriptor created by the shell (3> in run_pipe_test)
	## doesn't get inherited to the 'cat' commands in the following text
	@local uname;

	test_tempname();
	uname = sys::uname()
	if (uname["sysname"] ~ /Linux|Unix/) {
		run_pipe_test("inherit-default", "BEGIN { print \"hello\" | \"cat >&3\" }", "hello\n");
		run_pipe_test("cloexec-global", "BEGIN { PIPECLOEXEC = 1; print \"hello\" | \"cat >&3\" }", "");
		run_pipe_test("inherit-global-off", "BEGIN { PIPECLOEXEC = 0; print \"hello\" | \"cat >&3\" }", "hello\n");
		run_pipe_test("cloexec-pragma", "@pragma pipecloexec on\nBEGIN { print \"hello\" | \"cat >&3\" }", "");
	} else {
		tap_skip("PIPECLOEXEC not relevant");
	}

	tap_end();
}
